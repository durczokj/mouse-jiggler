#!/bin/bash

# Check if cliclick is installed
if ! command -v cliclick &> /dev/null; then
    echo "Error: cliclick is not installed."
    echo "Please install it using: brew install cliclick"
    exit 1
fi

# Function to get current mouse position
get_mouse_position() {
    cliclick p
}

# Function to move mouse to specific coordinates  
move_mouse() {
    local x=$1
    local y=$2
    cliclick m:$x,$y
}

# Function to get random number in range
random_in_range() {
    local min=$1
    local max=$2
    echo $(( RANDOM % (max - min + 1) + min ))
}

# Function to jiggle back and forth
jiggle_mouse() {
    local base_x=$1
    local base_y=$2
    local direction=1
    
    echo "Starting jiggling pattern..."
    
    # Jiggle for up to 100 iterations but stop immediately if movement detected
    while true; do
        # Check if user moved the mouse before each jiggle
        current_pos=$(get_mouse_position)
        current_x=$(echo "$current_pos" | cut -d',' -f1 | tr -d ' ')
        current_y=$(echo "$current_pos" | cut -d',' -f2 | tr -d ' ')
        
        # If mouse position changed from base position, stop jiggling immediately
        x_diff=$((current_x - base_x))
        y_diff=$((current_y - base_y))
        
        if [ ${x_diff#-} -gt 2 ] || [ ${y_diff#-} -gt 2 ]; then
            echo "User movement detected, stopping jiggle immediately"
            return
        fi
        
        # Move 1 pixel left or right
        new_x=$((base_x + direction))
        move_mouse "$new_x" "$base_y"
        
        # Alternate direction
        direction=$((-direction))
        
        sleep 0.01
    done
    
    # Return to original position
    move_mouse "$base_x" "$base_y"
    echo "Jiggling complete, returned to original position"
}

echo "Mouse jiggler started. Press Ctrl+C to stop."

while true; do
    # Get current mouse position
    old_pos=$(get_mouse_position)
    old_x=$(echo "$old_pos" | cut -d',' -f1 | tr -d ' ')
    old_y=$(echo "$old_pos" | cut -d',' -f2 | tr -d ' ')
    
    sleep 5
    
    # Get current mouse position again
    current_pos=$(get_mouse_position)
    current_x=$(echo "$current_pos" | cut -d',' -f1 | tr -d ' ')
    current_y=$(echo "$current_pos" | cut -d',' -f2 | tr -d ' ')
    
    # Check if mouse hasn't moved much
    x_diff=$((current_x - old_x))
    y_diff=$((current_y - old_y))
    
    if [ ${x_diff#-} -lt 2 ] && [ ${y_diff#-} -lt 2 ]; then
        # Get current time
        current_time=$(date "+%Y-%m-%dT%H:%M:%S%z")
        echo "$current_time – No movement detected, starting jiggle pattern"
        
        # Start jiggling back and forth
        jiggle_mouse "$current_x" "$current_y"
    fi
done