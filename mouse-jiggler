#!/bin/bash

# Check if cliclick is installed
if ! command -v cliclick &> /dev/null; then
    echo "Error: cliclick is not installed."
    echo "Please install it using: brew install cliclick"
    exit 1
fi

# Function to get an ISO timestamp
get_iso_timestamp() {
    date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# Function to get current mouse position
get_mouse_position() {
    cliclick p
}

# Function to check idle time
check_idle_time() {
    ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print $NF/1000000000; exit}'
}

# Function to move mouse to specific coordinates  
move_mouse() {
    local x=$1
    local y=$2
    cliclick m:$x,$y
}

# Function to jiggle back and forth
jiggle_mouse() {
    # Get current mouse position
    current_pos=$(get_mouse_position)
    local base_x=$(echo "$current_pos" | cut -d',' -f1 | tr -d ' ')
    local base_y=$(echo "$current_pos" | cut -d',' -f2 | tr -d ' ')

    # Set initial direction
    local direction=1
    
    echo "$(get_iso_timestamp) – Starting jiggle."

    # Jiggle back and forth
    while true; do

        # If user is active, stop jiggling
        idle_time=$(check_idle_time)
        if (( $(echo "$idle_time < 0.5" | bc -l) )); then
            echo "$(get_iso_timestamp) – User is active. Stopping jiggle."
            return
        fi
        
        # Move 1 pixel left or right
        new_x=$((base_x + direction))
        move_mouse "$new_x" "$base_y"
        
        # Alternate direction
        direction=$((-direction))
        
        sleep 0.5
    done
}

# Main loop
main() {
    echo "$(get_iso_timestamp) – Mouse jiggler started. Press Ctrl+C to stop."

    while true; do
        sleep 5

        idle_time=$(check_idle_time)

        if (( $(echo "$idle_time > 5.0" | bc -l) )); then
            echo "$(get_iso_timestamp) – No movement detected for over 5 seconds."
            jiggle_mouse
        fi
    done
}

main
